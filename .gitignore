# vscode
.vscode

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Don't include editor configs
.editorconfig

# Exclude sourcemaps
*.map

# Don't include npm stuff
.npmrc

# obsidian
data.json
noteWidthDatabase.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

testing
test-vault
# test-vault-master IS tracked (git-managed reference for the e2e test suite);
# only per-user runtime bits inside it are excluded:
test-vault-master/.obsidian/workspace.json
test-vault-master/.obsidian/graph.json
test-vault-master/.obsidian/plugins/
test-vault-master/.obsidian/themes/
condition.txt

#misc
app.json
appearance.json
workspace.json
hotkeys.json
core-plugins.json
core-plugins-migration.json

# Override the generic obsidian excludes above for the master-vault configs
# (these must be tracked so the e2e suite gets a deterministic bootstrap).
!test-vault-master/.obsidian/app.json
!test-vault-master/.obsidian/appearance.json
!test-vault-master/.obsidian/core-plugins.json
!test-vault-master/.obsidian/community-plugins.json

temp/
.claude/
.gitlab-ci.yml

# e2e test suite: ignore per-run outputs and node_modules
e2e/node_modules/
e2e/vault/
e2e/.userdata/
e2e/screenshots/
e2e/report/
